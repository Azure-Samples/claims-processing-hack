# Copy to `.env` and fill in, or let `challenge-0/get-keys.sh` generate it for you.
# `.env` is git-ignored - never commit real keys.

# --- Microsoft Foundry project (used by all agent challenges) --------------
AI_FOUNDRY_PROJECT_ENDPOINT="https://<resource>.services.ai.azure.com/api/projects/<project>"
MODEL_DEPLOYMENT_NAME="gpt-5.4-mini"

# --- Azure OpenAI (v1 GA API - no api-version parameter) -------------------
AZURE_OPENAI_ENDPOINT="https://<resource>.services.ai.azure.com"
AZURE_OPENAI_BASE_URL="https://<resource>.services.ai.azure.com/openai/v1/"
# Leave AZURE_OPENAI_KEY empty to authenticate with DefaultAzureCredential (recommended).
AZURE_OPENAI_KEY=""
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-5.4-mini"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-3-large"

# --- Mistral Document AI (OCR) --------------------------------------------
MISTRAL_DOCUMENT_AI_ENDPOINT="https://<resource>.services.ai.azure.com"
MISTRAL_DOCUMENT_AI_KEY=""
MISTRAL_DOCUMENT_AI_DEPLOYMENT_NAME="mistral-document-ai-2512"

# --- Azure AI Search -------------------------------------------------------
SEARCH_SERVICE_NAME=""
SEARCH_SERVICE_ENDPOINT="https://<search>.search.windows.net"
SEARCH_ADMIN_KEY=""
SEARCH_INDEX_NAME="insurance-documents-index"

# --- Azure Storage ---------------------------------------------------------
AZURE_STORAGE_ACCOUNT_NAME=""
AZURE_STORAGE_ACCOUNT_KEY=""
AZURE_STORAGE_CONNECTION_STRING=""

# --- Azure Cosmos DB -------------------------------------------------------
COSMOS_ENDPOINT=""
COSMOS_KEY=""

# --- Document Intelligence -------------------------------------------------
DOCUMENT_INTELLIGENCE_ENDPOINT=""
DOCUMENT_INTELLIGENCE_KEY=""

# --- Observability (challenge 3) ------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=""

# --- Deployment targets (challenge 4) -------------------------------------
AZURE_RESOURCE_GROUP=""
ACR_NAME=""
AZURE_CONTAINER_REGISTRY_NAME=""
CONTAINER_APP_ENVIRONMENT_NAME=""
